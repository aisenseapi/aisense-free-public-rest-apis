          "Agent Queue"
        ],
        "operationId": "create_agent_queue",
        "summary": "Create a queue with a fixed 24-hour lifetime",
        "description": "No parameters. An empty JSON object is accepted. Issues all three role tokens only once. At most 20 creations per client IP in a fixed 24-hour window starting with its first creation. This is separate from the shared daily request limit. No operation can extend expire_timestamp.",
        "security": [],
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed for this route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
