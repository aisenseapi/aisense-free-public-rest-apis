          "400": {
            "description": "Invalid JSON or request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or malformed Authorization Bearer header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The supplied token is invalid or does not grant the required role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown queue or job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed for this route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Receipt is stale, expired or does not own the current claim",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Queue expired. After its record is cleaned up the response becomes 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 1024 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "A nonempty body requires Content-Type: application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Creation or shared request limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Queue storage or locking unavailable. Retry after a delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "queue_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/QueueId"
            }
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/QueueId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "QueueReadToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "64 lowercase hex characters",
        "description": "The read_token from queue creation. Credentials are accepted only in the Authorization header, never in URLs."
      },
      "QueueWriteToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "64 lowercase hex characters",
        "description": "The write_token from queue creation. Credentials are accepted only in the Authorization header, never in URLs."
      },
      "QueueWorkerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "64 lowercase hex characters",
        "description": "The worker_token from queue creation. Credentials are accepted only in the Authorization header, never in URLs."
      }
    },
    "schemas": {
      "QueueId": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "QueueToken": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Secret capability issued only at queue creation. Send as Authorization: Bearer TOKEN in REST, never in a URL."
      },
      "ClaimReceipt": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Secret receipt returned only by this job's claim attempt."
      },
      "VisibilityTimeout": {
        "type": "integer",
        "minimum": 30,
        "maximum": 900,
        "default": 60,
        "description": "Visibility seconds, capped at the queue's fixed expiry."
      },
      "JobKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
        "minLength": 1,
        "maxLength": 64
      },
      "Counts": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "claimed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "pending",
          "claimed",
          "completed",
          "failed",
          "total"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "job_key": {
            "$ref": "#/components/schemas/JobKey"
          },
          "payload": {
            "description": "Any JSON value, including null, up to 16384 bytes when encoded. The Queue service writes payload content to its JSON state files without encrypting it. It normalizes object-key ordering and JSON serialization. Exclude credentials and sensitive personal data."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "claimed",
              "completed",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "created_at_timestamp": {
            "type": "integer"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "claimed_until_timestamp": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Integer while status is claimed. Null for pending, completed and failed jobs."
          }
        },
        "required": [
          "job_id",
          "job_key",
          "payload",
          "status",
          "attempts",
          "created_at_timestamp",
          "expire_timestamp",
          "claimed_until_timestamp"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ClaimedJob": {
        "type": "object",
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "job_key": {
            "$ref": "#/components/schemas/JobKey"
          },
          "payload": {
            "description": "Any JSON value, including null, up to 16384 bytes when encoded. The Queue service writes payload content to its JSON state files without encrypting it. It normalizes object-key ordering and JSON serialization. Exclude credentials and sensitive personal data."
          },
          "status": {
            "type": "string",
            "const": "claimed"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "created_at_timestamp": {
            "type": "integer"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "claimed_until_timestamp": {
            "type": "integer"
          },
          "receipt": {
            "$ref": "#/components/schemas/ClaimReceipt"
          }
        },
        "required": [
          "job_id",
          "job_key",
          "payload",
          "status",
          "attempts",
          "created_at_timestamp",
          "expire_timestamp",
          "claimed_until_timestamp",
          "receipt"
        ],
        "additionalProperties": false
      },
      "QueueRead": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "queue_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "created_at_timestamp": {
            "type": "integer"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "counts": {
            "$ref": "#/components/schemas/Counts"
          }
        },
        "required": [
          "ok",
          "queue_id",
          "created_at_timestamp",
          "expire_timestamp",
          "counts"
        ],
        "additionalProperties": false
      },
      "QueueCreated": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "queue_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "created_at_timestamp": {
            "type": "integer"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "counts": {
            "$ref": "#/components/schemas/Counts"
          },
          "read_token": {
            "$ref": "#/components/schemas/QueueToken"
          },
          "write_token": {
            "$ref": "#/components/schemas/QueueToken"
          },
          "worker_token": {
            "$ref": "#/components/schemas/QueueToken"
          }
        },
        "required": [
          "ok",
          "queue_id",
          "created_at_timestamp",
          "expire_timestamp",
          "counts",
          "read_token",
          "write_token",
          "worker_token"
        ],
        "additionalProperties": false
      },
      "JobResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "queue_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          }
        },
        "required": [
          "ok",
          "queue_id",
          "expire_timestamp",
          "job"
        ],
        "additionalProperties": false
      },
      "EnqueueResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "queue_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "deduplicated": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "queue_id",
          "expire_timestamp",
          "job",
          "deduplicated"
        ],
        "additionalProperties": false
      },
      "ClaimResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "queue_id": {
            "$ref": "#/components/schemas/QueueId"
          },
          "expire_timestamp": {
            "type": "integer"
          },
          "job": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClaimedJob"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "queue_id",
          "expire_timestamp",
          "job"
        ],
        "additionalProperties": false
      },
      "EnqueueInput": {
        "type": "object",
        "properties": {
          "job_key": {
            "$ref": "#/components/schemas/JobKey"
          },
          "payload": {
            "description": "Any JSON value, including null, up to 16384 bytes when encoded. The Queue service writes payload content to its JSON state files without encrypting it. It normalizes object-key ordering and JSON serialization. Exclude credentials and sensitive personal data."
          }
        },
        "required": [
          "job_key",
          "payload"
        ],
        "additionalProperties": false
      },
      "ClaimInput": {
        "type": "object",
        "properties": {
          "visibility_timeout": {
            "$ref": "#/components/schemas/VisibilityTimeout"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "ReceiptInput": {
        "type": "object",
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/ClaimReceipt"
          }
        },
        "required": [
          "receipt"
        ],
        "additionalProperties": false
      },
      "RenewInput": {
        "type": "object",
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/ClaimReceipt"
          },
          "visibility_timeout": {
            "$ref": "#/components/schemas/VisibilityTimeout"
          }
        },
        "required": [
          "receipt"
        ],
        "additionalProperties": false
      }
    }
  }
}
