# aisense.no - redirects from the pre-rebuild URL scheme, and the error page.
#
# The old site published one page per endpoint under
# /free-public-api-<name>-api-endpoint. The rebuild consolidated those into
# topic pages, which left every indexed URL answering 404 with the bare
# Apache error page. Each rule below sends one old URL to the page that now
# covers its content, with 301 so search engines transfer the ranking.
#
# Everything is wrapped in IfModule so a host without mod_alias ignores the
# file instead of failing. Only Redirect/ErrorDocument directives are used,
# both allowed under AllowOverride FileInfo.
#
# Adding a rule: match the old path exactly, allow an optional trailing
# slash, and point at a page that genuinely covers the topic - a redirect to
# an unrelated page is treated as a soft 404 and ranks no better than the
# real one.

<IfModule mod_alias.c>

# -- hashing: each algorithm has its own page ------------------------------
RedirectMatch 301 ^/free-public-api-md5-hash-api-endpoint/?$ https://aisense.no/md5-hash-api
RedirectMatch 301 ^/free-public-api-sha1-hash-api-endpoint/?$ https://aisense.no/sha1-hash-api
RedirectMatch 301 ^/free-public-api-sha256-hash-api-endpoint/?$ https://aisense.no/sha256-hash-api
RedirectMatch 301 ^/free-public-api-sha512-hash-api-endpoint/?$ https://aisense.no/sha512-hash-api

# -- encoding: one page per alphabet ---------------------------------------
RedirectMatch 301 ^/free-public-api-base64-(en|de)code-api-endpoint/?$ https://aisense.no/base64-api
RedirectMatch 301 ^/free-public-api-base58-(en|de)code-api-endpoint/?$ https://aisense.no/base58-api
RedirectMatch 301 ^/free-public-api-base32-(en|de)code-api-endpoint/?$ https://aisense.no/base32-api
RedirectMatch 301 ^/free-public-api-jwt-(en|de)code-api-endpoint/?$ https://aisense.no/jwt-api

# -- qr codes ---------------------------------------------------------------
RedirectMatch 301 ^/free-public-api-qr-code-(en|de)code-api-endpoint/?$ https://aisense.no/qr-code-api

# -- random generators ------------------------------------------------------
RedirectMatch 301 ^/free-public-api-(uuid|guid)-api-endpoint/?$ https://aisense.no/uuid-generator-api
RedirectMatch 301 ^/free-public-api-random-color-api-endpoint/?$ https://aisense.no/random-color-api
RedirectMatch 301 ^/free-public-api-random-number-api-endpoint/?$ https://aisense.no/random-number-api

# -- time -------------------------------------------------------------------
RedirectMatch 301 ^/free-public-api-(datetime|timestamp|microtimestamp)-api-endpoint/?$ https://aisense.no/unix-timestamp-api
RedirectMatch 301 ^/free-public-api-timezones-api-endpoint/?$ https://aisense.no/timezones-api
RedirectMatch 301 ^/free-public-api-swatchinternettime-api-endpoint/?$ https://aisense.no/swatch-internet-time-api

# -- endpoints that kept a page of their own --------------------------------
RedirectMatch 301 ^/free-public-api-storage-api-endpoint/?$ https://aisense.no/temporary-storage-api
RedirectMatch 301 ^/free-public-api-url-shortener-api-endpoint/?$ https://aisense.no/url-shortener-api
RedirectMatch 301 ^/free-public-api-webhook-capture-api-endpoint/?$ https://aisense.no/webhook-capture-api
RedirectMatch 301 ^/free-public-api-webhook-action-api-endpoint/?$ https://aisense.no/webhook-action-api
RedirectMatch 301 ^/free-public-api-ip-reverse-lookup-api-endpoint/?$ https://aisense.no/ip-reverse-lookup-api

# -- network, documents and status ------------------------------------------
RedirectMatch 301 ^/free-public-api-client-ip-api-endpoint/?$ https://aisense.no/client-ip-api
RedirectMatch 301 ^/free-public-api-ping-api-endpoint/?$ https://aisense.no/ping-api
RedirectMatch 301 ^/free-public-api-health-api-endpoint/?$ https://aisense.no/health-check-api
RedirectMatch 301 ^/free-public-api-html-to-pdf-api-endpoint/?$ https://aisense.no/html-to-pdf-api
RedirectMatch 301 ^/(client_ip)/?$ https://aisense.no/client-ip-api
RedirectMatch 301 ^/(html2pdf)/?$ https://aisense.no/html-to-pdf-api
RedirectMatch 301 ^/(upload)/?$ https://aisense.no/free-public-apis

# -- crypto wallets ---------------------------------------------------------
RedirectMatch 301 ^/free-public-api-bitcoin-generate-new-wallet-api-endpoint/?$ https://aisense.no/bitcoin-wallet-api
RedirectMatch 301 ^/free-public-api-ethereum-generate-new-wallet-api-endpoint/?$ https://aisense.no/ethereum-wallet-api
RedirectMatch 301 ^/free-public-api-solana-generate-new-wallet-api-endpoint/?$ https://aisense.no/solana-wallet-api

# -- anything else in the old endpoint scheme -------------------------------
# Catch-all for endpoint pages not named above, so none of them dead-ends.
RedirectMatch 301 ^/free-public-api-[a-z0-9-]+-api-endpoint/?$ https://aisense.no/free-public-apis

# ── renamed and superseded pages ─────────────────────────────────────────
RedirectMatch 301 ^/custom-iot-beehive-monitoring-system/?$ https://aisense.no/smart-beehive-monitoring-system
RedirectMatch 301 ^/aisense-ai-data-feed-specification(-complete)?-v1-0/?$ https://aisense.no/make-your-data-available-for-ai
RedirectMatch 301 ^/universal-real-world-tokenization-framework.*$ https://aisense.no/ai-sense-posts

# ── leftovers from the WordPress install ─────────────────────────────────
RedirectMatch 301 ^/(feed|comments/feed)/?$ https://aisense.no/ai-sense-posts
RedirectMatch 301 ^/(category|author|tag)/.*$ https://aisense.no/
RedirectMatch 301 ^/(.+)/embed/?$ https://aisense.no/$1

</IfModule>

# Branded error page instead of the stock Apache one. The response keeps its
# 404 status; only the body changes.
ErrorDocument 404 /404.html
