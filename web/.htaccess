# aisense.no - redirects from the pre-rebuild URL scheme, and the error page.
#
# The old site published one page per endpoint under
# /free-public-api-<name>-api-endpoint. The rebuild consolidated those into
# topic pages, which left every indexed URL answering 404 with the bare
# Apache error page. Each rule below sends one old URL to the page that now
# covers its content, with 301 so search engines transfer the ranking.
#
# Everything is wrapped in IfModule so a host without mod_alias ignores the
# file instead of failing. Only Redirect/ErrorDocument directives are used,
# both allowed under AllowOverride FileInfo.
#
# Adding a rule: match the old path exactly, allow an optional trailing
# slash, and point at a page that genuinely covers the topic - a redirect to
# an unrelated page is treated as a soft 404 and ranks no better than the
# real one.

<IfModule mod_alias.c>

# The endpoint pages live at the original scheme, /free-public-api-<name>-api-endpoint.
# Those URLs are served directly and are NOT redirected. The shorter aliases below
# were live for one day and now point at the page that owns the content.

RedirectMatch 301 ^/base32-api/?$ https://aisense.no/free-public-api-base32-encode-api-endpoint
RedirectMatch 301 ^/base58-api/?$ https://aisense.no/free-public-api-base58-encode-api-endpoint
RedirectMatch 301 ^/base64-api/?$ https://aisense.no/free-public-api-base64-encode-api-endpoint
RedirectMatch 301 ^/bitcoin-wallet-api/?$ https://aisense.no/free-public-api-bitcoin-generate-new-wallet-api-endpoint
RedirectMatch 301 ^/client-ip-api/?$ https://aisense.no/free-public-api-client-ip-api-endpoint
RedirectMatch 301 ^/crc32-checksum-api/?$ https://aisense.no/free-public-api-crc32-checksum-api-endpoint
RedirectMatch 301 ^/domain-ip-lookup-api/?$ https://aisense.no/free-public-api-domain-ip-lookup-api-endpoint
RedirectMatch 301 ^/email-validation-api/?$ https://aisense.no/free-public-api-email-validate-api-endpoint
RedirectMatch 301 ^/ethereum-wallet-api/?$ https://aisense.no/free-public-api-ethereum-generate-new-wallet-api-endpoint
RedirectMatch 301 ^/hash-verify-api/?$ https://aisense.no/free-public-api-hash-verify-api-endpoint
RedirectMatch 301 ^/health-check-api/?$ https://aisense.no/free-public-api-health-api-endpoint
RedirectMatch 301 ^/html-to-pdf-api/?$ https://aisense.no/free-public-api-html-to-pdf-api-endpoint
RedirectMatch 301 ^/ip-reverse-lookup-api/?$ https://aisense.no/free-public-api-ip-reverse-lookup-api-endpoint
RedirectMatch 301 ^/jwt-api/?$ https://aisense.no/free-public-api-jwt-encode-api-endpoint
RedirectMatch 301 ^/md5-hash-api/?$ https://aisense.no/free-public-api-md5-hash-api-endpoint
RedirectMatch 301 ^/password-generator-api/?$ https://aisense.no/free-public-api-password-api-endpoint
RedirectMatch 301 ^/ping-api/?$ https://aisense.no/free-public-api-ping-api-endpoint
RedirectMatch 301 ^/qr-code-api/?$ https://aisense.no/free-public-api-qr-code-encode-api-endpoint
RedirectMatch 301 ^/random-color-api/?$ https://aisense.no/free-public-api-random-color-api-endpoint
RedirectMatch 301 ^/random-number-api/?$ https://aisense.no/free-public-api-random-number-api-endpoint
RedirectMatch 301 ^/sha1-hash-api/?$ https://aisense.no/free-public-api-sha1-hash-api-endpoint
RedirectMatch 301 ^/sha256-hash-api/?$ https://aisense.no/free-public-api-sha256-hash-api-endpoint
RedirectMatch 301 ^/sha512-hash-api/?$ https://aisense.no/free-public-api-sha512-hash-api-endpoint
RedirectMatch 301 ^/slugify-api/?$ https://aisense.no/free-public-api-slugify-api-endpoint
RedirectMatch 301 ^/solana-wallet-api/?$ https://aisense.no/free-public-api-solana-generate-new-wallet-api-endpoint
RedirectMatch 301 ^/swatch-internet-time-api/?$ https://aisense.no/free-public-api-swatchinternettime-api-endpoint
RedirectMatch 301 ^/temporary-storage-api/?$ https://aisense.no/free-public-api-storage-api-endpoint
RedirectMatch 301 ^/timestamp-converter-api/?$ https://aisense.no/free-public-api-timestamp-convert-api-endpoint
RedirectMatch 301 ^/timezones-api/?$ https://aisense.no/free-public-api-timezones-api-endpoint
RedirectMatch 301 ^/unix-timestamp-api/?$ https://aisense.no/free-public-api-timestamp-api-endpoint
RedirectMatch 301 ^/url-shortener-api/?$ https://aisense.no/free-public-api-url-shortener-api-endpoint
RedirectMatch 301 ^/user-agent-api/?$ https://aisense.no/free-public-api-user-agent-api-endpoint
RedirectMatch 301 ^/uuid-generator-api/?$ https://aisense.no/free-public-api-uuid-api-endpoint
RedirectMatch 301 ^/validation-api/?$ https://aisense.no/free-public-api-validate-api-endpoint
RedirectMatch 301 ^/webhook-action-api/?$ https://aisense.no/free-public-api-webhook-action-api-endpoint
RedirectMatch 301 ^/webhook-capture-api/?$ https://aisense.no/free-public-api-webhook-capture-api-endpoint
RedirectMatch 301 ^/webhook-schedule-api/?$ https://aisense.no/free-public-api-webhook-schedule-api-endpoint

# Pages renamed or superseded when the site was rebuilt.
RedirectMatch 301 ^/custom-iot-beehive-monitoring-system/?$ https://aisense.no/smart-beehive-monitoring-system
RedirectMatch 301 ^/aisense-ai-data-feed-specification(-complete)?-v1-0/?$ https://aisense.no/make-your-data-available-for-ai
RedirectMatch 301 ^/universal-real-world-tokenization-framework.*$ https://aisense.no/ai-sense-posts

# Loose ends from the WordPress install.
RedirectMatch 301 ^/(client_ip)/?$ https://aisense.no/free-public-api-client-ip-api-endpoint
RedirectMatch 301 ^/(html2pdf)/?$ https://aisense.no/free-public-api-html-to-pdf-api-endpoint
RedirectMatch 301 ^/(upload)/?$ https://aisense.no/free-public-apis
RedirectMatch 301 ^/(feed|comments/feed)/?$ https://aisense.no/ai-sense-posts
RedirectMatch 301 ^/(category|author|tag)/.*$ https://aisense.no/
RedirectMatch 301 ^/(.+)/embed/?$ https://aisense.no/$1

</IfModule>

# Branded error page instead of the stock Apache one. The response keeps its
# 404 status; only the body changes.
ErrorDocument 404 /404.html
